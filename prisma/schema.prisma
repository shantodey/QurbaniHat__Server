generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  name     String
  userName String
  email    String
  password String
  role     UserRole @default(User)
  avatar   String?
  orders   Orders[]

  @@map("users")
}

enum UserRole {
  User
  Admin
  Manager
}

model Product {
  id          String   @id @default(uuid())
  titel       String
  type        String
  breed       String
  price       Int
  weight      Int
  age         Int
  description String
  image       String
  category    String
  orders      Orders[]   

  @@map("products")
}

model Orders {
  id        String  @id @default(uuid())
  userid    String
  user      User    @relation(fields: [userid], references: [id])
  productid String
  product   Product @relation(fields: [productid], references: [id])
  titel       String 
  type        String
  breed       String
  price       Int
  weight      Int
}
