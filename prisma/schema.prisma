

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Users{
  id Stirng @id @default{uuid()}
  name Stirng
  userName Stirng
  email Stirng 
  password Stirng
  role UserRole @default(User)
  avatar Stirng?



  @@map("users__table)
  @@unique({email,userName})
  @@index({email,userName})
}

enam UserRole{
  User
  Admin
  Manager
}